{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @relay/web build",
  "fluid": true,
  "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/internal/jobs/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/app/api/extension/**/*": {
      "maxDuration": 10
    }
  }
}
