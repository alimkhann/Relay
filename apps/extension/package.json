{
  "name": "@relay/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:prod": "plasmo build --tag prod",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@relay/adapters": "workspace:*",
    "@relay/shared": "workspace:*",
    "plasmo": "^0.90.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "manifest": {
    "name": "Relay",
    "description": "Keep project memory moving between ChatGPT, Claude, and Perplexity.",
    "key": "",
    "permissions": [
      "storage",
      "tabs",
      "activeTab",
      "sidePanel",
      "identity"
    ],
    "host_permissions": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://codex.openai.com/*",
      "https://www.perplexity.ai/*",
      "https://claude.ai/*",
      "$PLASMO_PUBLIC_RELAY_API_BASE/*"
    ],
    "externally_connectable": {
      "matches": [
        "$PLASMO_PUBLIC_RELAY_API_BASE/*",
        "http://localhost:3000/*"
      ]
    },
    "content_scripts": [
      {
        "matches": [
          "https://chatgpt.com/*",
          "https://chat.openai.com/*",
          "https://codex.openai.com/*",
          "https://www.perplexity.ai/*",
          "https://claude.ai/*"
        ],
        "js": [
          "../static/relay-content.js"
        ],
        "run_at": "document_idle"
      }
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "action": {
      "default_title": "Relay",
      "default_popup": "popup.html"
    },
    "commands": {
      "insert-project-brief": {
        "suggested_key": {
          "default": "Ctrl+Shift+I",
          "mac": "Command+Shift+I"
        },
        "description": "Insert the current project brief"
      }
    }
  }
}
