NEXT_PUBLIC_RELAY_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://t.your-domain.com
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
DATABASE_URL=
LOCAL_DATABASE_URL=postgres://relay:relay@127.0.0.1:54329/relay_local
DATABASE_URL_UNPOOLED=
RELAY_PROD_DATABASE_URL=
AUTH_PROVIDER=local
LOCAL_AUTH_SESSION_SECRET=
GEMINI_API_KEY=
RELAY_INTERNAL_API_SECRET=
RELAY_BROWSER_HANDOFF_SECRET=
RELAY_CONTENT_ENCRYPTION_KEY=

# Project Sources.
# Use RELAY_SOURCE_STORAGE_MODE=memory only for local parser/UI tests that should not write blobs.
# Leave it empty, or set it to r2, for deployed R2-backed source storage.
# RELAY_SOURCE_ENCRYPTION_KEY protects raw source blobs with app-layer envelope encryption.
# If omitted, Relay falls back to RELAY_CONTENT_ENCRYPTION_KEY.
RELAY_SOURCE_ENCRYPTION_KEY=
RELAY_SOURCE_STORAGE_MODE=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
NEON_AUTH_COOKIE_SECRET=
PLASMO_PUBLIC_RELAY_API_BASE=http://localhost:3000
PLASMO_PUBLIC_POSTHOG_KEY=
PLASMO_PUBLIC_POSTHOG_HOST=https://t.your-domain.com
PLASMO_PUBLIC_RELAY_AUTH_PROVIDER=local
PLASMO_PUBLIC_CRX_GOOGLE_CLIENT_ID=
CRX_PUBLIC_KEY=
# Chrome extension ID — used by the web app to ping the installed extension
# after billing state changes so the side panel refreshes immediately.
NEXT_PUBLIC_EXTENSION_ID=
RELAY_POSTHOG_KEY=
RELAY_POSTHOG_HOST=https://t.your-domain.com

# Polar billing (set POLAR_SANDBOX=true for sandbox.polar.sh)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_STARTER_MONTHLY=
POLAR_PRODUCT_ID_STARTER_ANNUAL=
POLAR_PRODUCT_ID_PRO_MONTHLY=
POLAR_PRODUCT_ID_PRO_ANNUAL=
POLAR_SANDBOX=false

# Email (Resend)
RESEND_API_KEY=
