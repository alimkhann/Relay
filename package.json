{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm --filter @relay/shared build && pnpm --filter @relay/formatters build && pnpm --filter @relay/adapters build && pnpm --filter @relay/db build && pnpm --filter @relay/web build && pnpm --filter @relay/extension build",
    "build:extension:prod": "pnpm --filter @relay/extension build:prod",
    "build:cli": "pnpm --filter @relay/cli build",
    "build:mcp": "pnpm --filter @relay/mcp build",
    "db:local:start": "docker compose -f docker-compose.local.yml up -d",
    "db:local:stop": "docker compose -f docker-compose.local.yml down",
    "db:local:migrate": "node scripts/db-admin.js migrate",
    "db:prod:migrate": "MIGRATION_DATABASE_URL=\"${RELAY_PROD_DATABASE_URL:?RELAY_PROD_DATABASE_URL is required}\" node scripts/db-admin.js migrate",
    "db:local:seed:user": "node scripts/db-admin.js seed-local-user",
    "db:local:reset": "RELAY_CONFIRM_PURGE=YES node scripts/db-admin.js purge-users",
    "db:local:count": "node scripts/db-admin.js count",
    "dev:web": "pnpm --filter @relay/web dev",
    "dev:extension": "pnpm --filter @relay/extension dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
