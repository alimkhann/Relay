# Copy to .env and fill in
DATABASE_URL=postgres://relay:relay@localhost:54329/relay_local
LOCAL_DATABASE_URL=postgres://relay:relay@localhost:54329/relay_local
AUTH_PROVIDER=local

# User seeded via `pnpm db:local:seed:user` (local@relay.test)
RELAY_TEST_USER_ID=f61c44d8-435e-4576-be47-ab4792f1aac9

# OpenAI — paste the NEW rotated key here, never commit
OPENAI_API_KEY=

# Models
ANSWER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Hard ceiling — harness throws if projected cost exceeds this
MAX_SPEND_USD=1.50

# Smoke testing
# LIMIT_QUESTIONS=5
# DRY_RUN=1       # skip OpenAI calls, return stub hypotheses
